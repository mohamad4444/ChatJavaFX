   <children>
      <TextArea fx:id="chatarea" layoutX="20.0" layoutY="6.0" prefHeight="262.0" prefWidth="501.0" />
      <TextField fx:id="sendTextArea" layoutX="20.0" layoutY="285.0" onAction="#enterPressed" prefHeight="36.0" prefWidth="502.0" />
      <Button layoutX="534.0" layoutY="290.0" mnemonicParsing="false" onAction="#sendButtonClicked" text="send" />
   </children>
</AnchorPane>
